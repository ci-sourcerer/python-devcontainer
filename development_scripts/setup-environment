#!/bin/sh

set -e

PACKAGE_MANAGER=${PACKAGE_MANAGER:-}

if [ -z "$PACKAGE_MANAGER" ]; then
    if [ -f pyproject.toml ] && grep -Eq '^\[tool\.uv\]' pyproject.toml; then
        PACKAGE_MANAGER=uv
    elif [ -f pyproject.toml ] && grep -Eq '^\[tool\.poetry\]' pyproject.toml; then
        PACKAGE_MANAGER=poetry
    elif [ -f uv.lock ]; then
        PACKAGE_MANAGER=uv
    elif [ -f poetry.lock ]; then
        PACKAGE_MANAGER=poetry
    else
        PACKAGE_MANAGER=poetry
    fi
fi

case "$PACKAGE_MANAGER" in
    poetry)
        if [ -d ".venv" ]; then
            printf 'Python package already installed via Poetry.\n\nBroken environment? Try running:\n\n\trm -rf .venv .poetry && PACKAGE_MANAGER=poetry setup-environment\n' >&2
            exit 0
        fi

        POETRY_DYNAMIC_VERSIONING_COMMANDS="" poetry install
        interpreterLocation=$(poetry run which python)
        ;;
    uv)
        if [ -d ".venv" ]; then
            printf 'Python package already installed via uv.\n\nBroken environment? Try running:\n\n\trm -rf .venv && PACKAGE_MANAGER=uv setup-environment\n' >&2
            exit 0
        fi

        UV_DYNAMIC_VERSIONING_BYPASS=0.0.0 uv sync
        interpreterLocation=$(uv run which python)
        ;;
    *)
        printf 'Unsupported PACKAGE_MANAGER: %s\n' "$PACKAGE_MANAGER" >&2
        exit 1
        ;;
esac

printf 'Python interpreter location: %s\n' "$interpreterLocation" >&2
if [ -f .pre-commit-config.yaml ]; then
    case "$PACKAGE_MANAGER" in
        poetry)
            poetry run pre-commit install
            ;;
        uv)
            uv run pre-commit install
            ;;
    esac
fi
