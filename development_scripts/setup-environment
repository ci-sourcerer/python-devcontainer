#!/bin/sh

set -e

if [ -d ".venv" ]; then
    printf 'Python package already installed via Poetry.\n\nBroken environment? Try running:\n\n\trm -rf .venv .poetry && setup-environment\n' >&2
    exit 0
fi

POETRY_DYNAMIC_VERSIONING_COMMANDS="" poetry install
interpreterLocation=$(poetry run which python)
printf 'Python interpreter location: %s\n' "$interpreterLocation" >&2
if [ -f .pre-commit-config.yaml ]; then
    poetry run pre-commit install
fi
